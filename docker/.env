#!/usr/bin/env bash

# See https://docs.docker.com/compose/environment-variables/#the-env-file

# Nginx
NGINX_HOST=localhost
NGINX_PORT=8000

# PHP

# See https://hub.docker.com/r/nanoninja/php-fpm/tags/
PHP_VERSION=latest

# PhpMyAdmin
PHP_MY_ADMIN_PORT=8080

# MySQL
MYSQL_OS_PORT=8989
MYSQL_OS_VERSION=8.4
MYSQL_OS_HOST=mysql
MYSQL_OS_DATABASE=os
MYSQL_OS_ROOT_USER=root
MYSQL_OS_ROOT_PASSWORD=root
MYSQL_OS_USER=os
MYSQL_OS_PASSWORD=os
